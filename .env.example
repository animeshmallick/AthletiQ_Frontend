# Base URL of the API. Leave empty in development to use the Vite proxy (same-origin, cookies just work).
# In production (e.g. AWS Amplify) set it to the public API origin, e.g. https://api.athletiq.example.com
VITE_API_URL=

# Dev-only: where the Vite dev server proxies /api requests.
API_PROXY_TARGET=http://localhost:4000

# Public Mapbox token (pk.*) for maps. Restrict it to your domains in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=
