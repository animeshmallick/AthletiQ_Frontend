# Base URL of the API. Leave empty in development to use the Vite proxy (same-origin, cookies just work).
# Production builds default to https://api.edupilots.in (see .env.production).
VITE_API_URL=

# Dev-only: where the Vite dev server proxies /api requests.
API_PROXY_TARGET=http://localhost:4000

# Public Mapbox token (pk.*) for maps. Restrict it to https://www.edupilots.in in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=

# Push notifications (iPhone Home Screen app + browsers). Firebase console → Project settings →
# General → Web app config, and Cloud Messaging → Web Push certificates. Empty = not offered.
# See IOS.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
